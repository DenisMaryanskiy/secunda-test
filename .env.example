# Скопируйте в .env, если запускаете процессы локально, без Docker.
# docker compose поднимается и без .env; там прописаны те же значения по умолчанию.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# Ключ для заголовка X-API-Key. В проде берется из менеджера секретов, не отсюда.
API_KEY=local-dev-key

DATABASE__URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
DATABASE__ECHO=false

BROKER__URL=amqp://guest:guest@localhost:5672/

# Сколько раз консьюмер возьмётся за сообщение, прежде чем отправить его в DLQ.
CONSUMER__MAX_ATTEMPTS=3
# Задержка перед повтором: base * 2^(attempt-1), то есть 2с, 4с.
CONSUMER__RETRY_BASE_DELAY_SECONDS=2
CONSUMER__PREFETCH_COUNT=10

# Эмуляция платёжного шлюза.
GATEWAY__MIN_DELAY_SECONDS=2
GATEWAY__MAX_DELAY_SECONDS=5
GATEWAY__SUCCESS_RATE=0.9

# Секрет для подписи webhook. Клиент проверяет ей заголовок X-Payment-Signature.
WEBHOOK__SIGNING_SECRET=local-dev-webhook-secret
WEBHOOK__TIMEOUT_SECONDS=5
WEBHOOK__MAX_ATTEMPTS=3
WEBHOOK__RETRY_BASE_DELAY_SECONDS=0.5
# Разрешает http и приватные адреса в webhook_url. Нужно, чтобы webhook долетал
# до соседнего контейнера в compose. В production включить не даст валидация конфига.
WEBHOOK__ALLOW_INSECURE_TARGETS=true

OUTBOX__POLL_INTERVAL_SECONDS=1
OUTBOX__BATCH_SIZE=100
